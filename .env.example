# ---- copy to .env and edit before deploying ----
# Core
SXM_DATABASE_URL=postgresql+psycopg2://sxm:sxm@postgres:5432/sxm
SXM_REDIS_URL=redis://redis:6379/0
SXM_SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-32
SXM_ACCESS_TOKEN_TTL_MINUTES=480

# Bootstrap admin (created on first start; change the password immediately)
SXM_ADMIN_USERNAME=admin
SXM_ADMIN_PASSWORD=change-me

# Confidence / lifecycle
SXM_CONFIRM_THRESHOLD=7
SXM_GONE_AFTER_DAYS=14

# Toggles (admin)
SXM_DAILY_SNAPSHOTS=false
SXM_AUTO_PROBE_ON_DOUBT=false

# Connector mode: fixtures (no external calls) | live
SXM_CONNECTOR_MODE=fixtures

# Source API keys (only needed when SXM_CONNECTOR_MODE=live)
SXM_TENABLE_ACCESS_KEY=
SXM_TENABLE_SECRET_KEY=
SXM_SHADOWSERVER_API_KEY=
SXM_SHADOWSERVER_SECRET=
SXM_SHODAN_API_KEY=
SXM_DNSDUMPSTER_API_KEY=

# Postgres container credentials (must match SXM_DATABASE_URL)
POSTGRES_USER=sxm
POSTGRES_PASSWORD=sxm
POSTGRES_DB=sxm

# ---- proxy / ingress ----
# FQDN for automatic Let's Encrypt certs; leave as localhost for internal CA.
SITE_ADDRESS=localhost

# ---- auto-probe / retention ----
SXM_AUTO_PROBE_MAX_PER_CYCLE=25
SXM_OBSERVATION_RETENTION_DAYS=90
SXM_RESOLVE_ENUMERATED=true

# ---- live source endpoints (used when SXM_CONNECTOR_MODE=live) ----
SXM_TENABLE_URL=https://cloud.tenable.com
SXM_SHADOWSERVER_URL=https://transform.shadowserver.org/api2/
SXM_SHADOWSERVER_REPORT_TYPES=scan_http,scan_https,scan_ssh,populate
SXM_DNSDUMPSTER_URL=https://api.dnsdumpster.com
# roadmap sources (seeded disabled; enable in the UI once configured)
SXM_ELSA_URL=
SXM_ELSA_API_KEY=
SXM_SOCRADAR_URL=https://platform.socradar.com/api
SXM_SOCRADAR_API_KEY=

# ---- email (SMTP) alert channel fallback ----
SXM_SMTP_HOST=
SXM_SMTP_PORT=587
SXM_SMTP_USER=
SXM_SMTP_PASSWORD=
SXM_SMTP_FROM=sxm@localhost
SXM_SMTP_USE_TLS=true

# ---- OIDC SSO (C6) — disabled by default; local accounts remain primary ----
SXM_OIDC_ENABLED=false
SXM_OIDC_ISSUER=
SXM_OIDC_CLIENT_ID=
SXM_OIDC_CLIENT_SECRET=
SXM_OIDC_REDIRECT_URI=https://localhost/api/auth/oidc/callback
SXM_OIDC_SCOPES=openid profile email
SXM_OIDC_ROLE_CLAIM=groups
SXM_OIDC_ROLE_MAP={"soc-admins":"admin","soc-analysts":"analyst","soc-viewers":"manager"}
SXM_OIDC_DEFAULT_ROLE=manager
