# --- SXM POC (no-Docker) environment ---
# Copy to /opt/sxm/sxm.env and edit. Absolute sqlite path needs FOUR slashes.
SXM_DATABASE_URL=sqlite+pysqlite:////opt/sxm/data/sxm.db

# REQUIRED: generate with `openssl rand -hex 32`
SXM_SECRET_KEY=CHANGE_ME
SXM_ADMIN_USERNAME=admin
SXM_ADMIN_PASSWORD=CHANGE_ME

# fixtures = works with no external keys; switch to live when ready
SXM_CONNECTOR_MODE=fixtures

# serve the SPA from the API process (single origin)
SXM_SERVE_UI=true

# scheduler cadence (seconds). POC-friendly values; raise toward daily/weekly for prod.
SXM_SCHEDULER_RUN_ON_START=true
SXM_SCHEDULER_FULL_CYCLE_SECONDS=3600
SXM_SCHEDULER_SNAPSHOT_SECONDS=86400
SXM_SCHEDULER_PURGE_SECONDS=604800

# toggles
SXM_AUTO_PROBE_ON_DOUBT=false
SXM_DAILY_SNAPSHOTS=false
