[Unit]
Description=SXM Scheduler (standalone, replaces Celery beat)
After=network.target sxm-api.service
Wants=sxm-api.service

[Service]
Type=simple
User=sxm
Group=sxm
WorkingDirectory=/opt/sxm/api
EnvironmentFile=/opt/sxm/sxm.env
# let the API finish first-boot DB bootstrap before the scheduler touches it
ExecStartPre=/bin/sleep 5
ExecStart=/opt/sxm/api/.venv/bin/python -m app.run_scheduler
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sxm/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
